# ============================================================
# FarmTech Solutions - Fase 7 - Variaveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# O arquivo .env NUNCA deve ser commitado (ja esta no .gitignore).
# ============================================================

# --- OpenWeather (servico de clima - Fases 1/2) ---
# Crie sua chave gratuita em https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_CIDADE=Sao Paulo
OPENWEATHER_PAIS=BR

# --- AWS SNS (servico de mensageria - Fase 7) ---
# Regiao escolhida: sa-east-1 (Sao Paulo), coerente com a analise de
# soberania de dados e latencia feita na Fase 5.
AWS_REGION=sa-east-1
SNS_TOPIC_ARN=
# Credenciais do usuario IAM "farmtech-app" (permissao minima: sns:Publish)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
